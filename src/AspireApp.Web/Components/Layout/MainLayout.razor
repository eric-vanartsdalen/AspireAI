@inherits LayoutComponentBase
@inject AuthenticationContext AuthenticationContext
@inject TenantContextService TenantContext

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 justify-content-between">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>

            <AuthorizeView Context="authState">
                <Authorized>
                    <div class="d-flex align-items-center gap-3" data-testid="auth-summary">
                        <div class="text-end">
                            <div class="fw-semibold"
                                 data-testid="auth-user-display"
                                 data-auth-tenant="@TenantContext.CurrentTenantId">
                                @authState.User.Identity?.Name
                            </div>
                            <div class="small text-muted">
                                @AuthenticationContext.CurrentUser?.ProviderDisplayName ·
                                <span>Tenant @TenantContext.CurrentTenantId</span>
                            </div>
                        </div>
                        <span class="badge rounded-pill text-bg-dark">@AuthenticationContext.CurrentUser?.Initials</span>
                        <a class="btn btn-outline-secondary btn-sm"
                           data-testid="auth-sign-out"
                           href="/auth/mock/signout?returnUrl=%2F">Sign out</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-secondary btn-sm" data-testid="auth-sign-in-nav" href="/signin">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
