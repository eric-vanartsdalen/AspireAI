@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationContext AuthenticationContext
@inject NavigationManager NavigationManager
@inject TenantContextService TenantContext

<div class="page @(_sidebarOpen ? "sidebar-open" : "")">
    <div class="sidebar">
        <NavMenu />
    </div>

    @if (_sidebarOpen)
    {
        <div class="sidebar-backdrop" @onclick="ToggleSidebar"></div>
    }

    <main>
        <div class="top-row px-4 justify-content-between">
            <button class="sidebar-toggle" @onclick="ToggleSidebar" title="Toggle navigation">
                ☰
            </button>

            <AuthorizeView Context="authState">
                <Authorized>
                    <div class="d-flex align-items-center gap-3" data-testid="auth-summary">
                        <div class="text-end">
                            <div class="fw-semibold"
                                 data-testid="auth-user-display"
                                 data-auth-tenant="@TenantContext.CurrentTenantId">
                                @authState.User.Identity?.Name
                            </div>
                            <div class="small topbar-secondary d-flex justify-content-end align-items-center gap-2">
                                <span>@AuthenticationContext.CurrentUser?.ProviderDisplayName · Tenant @TenantContext.CurrentTenantName</span>
                                @if (TenantContext.CurrentTenantIsProtected)
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Protected</span>
                                }
                            </div>
                        </div>
                        <span class="badge rounded-pill text-bg-dark">@AuthenticationContext.CurrentUser?.Initials</span>
                        <a class="btn btn-outline-secondary btn-sm"
                           data-testid="auth-sign-out"
                           href="/auth/signout?returnUrl=%2F">Sign out</a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-secondary btn-sm" data-testid="auth-sign-in-nav" href="/signin">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _sidebarOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        TenantContext.OnTenantChanged += HandleTenantChanged;
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = CloseSidebarAsync();
    }

    private void HandleTenantChanged()
    {
        _ = CloseSidebarAsync();
    }

    private Task CloseSidebarAsync()
    {
        if (!_sidebarOpen)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            _sidebarOpen = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        TenantContext.OnTenantChanged -= HandleTenantChanged;
    }
}
