@using AspireApp.Web.Components.Shared
@inject AuthenticationContext AuthenticationContext

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Aspire AI</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="px-3 py-2">
                    <div class="small text-uppercase text-muted">Signed in</div>
                    <div class="fw-semibold">@AuthenticationContext.CurrentUser?.DisplayName</div>
                    <div class="small text-muted">@AuthenticationContext.CurrentUser?.Email</div>
                </div>

                <div class="tenant-context-section">
                    <TenantSelector />
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="chat">
                        <span class="bi bi-chat-dots-fill" aria-hidden="true"></span> Chat
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="upload">
                        <span class="bi bi-cloud-upload-fill" aria-hidden="true"></span> Upload Documents
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="weather">
                        <span class="bi bi-list-nested" aria-hidden="true"></span> Weather
                    </NavLink>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="px-3 py-2 text-muted small">
                    Choose a mock identity on Home to unlock the full app shell.
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
